{
  "name": "wingman-cc",
  "version": "0.1.28",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:compile": "tsc -p tsconfig.electron.json && rm -rf electron-dist/hud electron-dist/tray-popover && cp -r electron/hud electron-dist/ && cp -r electron/tray-popover electron-dist/",
    "electron:launch": "electron electron-dist/main.js",
    "electron:dev": "concurrently --kill-others \"npm run dev\" \"npm run electron:wait\"",
    "electron:wait": "node scripts/wait-and-launch.js",
    "electron:pack": "npm run electron:compile && electron-builder --dir",
    "electron:dist": "npm run build && npm run electron:compile && electron-builder && codesign --force --deep --sign - dist/mac-arm64/Wingman.app 2>/dev/null || true",
    "electron:release": "npm run build && npm run electron:compile && electron-builder --publish always"
  },
  "main": "electron-dist/main.js",
  "dependencies": {
    "@react-three/fiber": "^9.5.0",
    "@recallai/desktop-sdk": "^2.0.8",
    "@stripe/stripe-js": "^4.0.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.12",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.0.8",
    "stripe": "^16.0.0",
    "tailwind-merge": "^2.6.1",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
