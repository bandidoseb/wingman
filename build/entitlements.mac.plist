<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  entitlements.mac.plist
  These are the permissions Wingman requests from macOS.
  Apple requires these to be declared for apps distributed outside the App Store.
-->
<plist version="1.0">
<dict>
  <!-- Allow the app to run hardened code (required for notarization) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Allow unsigned code execution (Electron needs this) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow loading third-party libraries not signed by Apple (Recall AI SDK needs this) -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Required for audio capture (Recall AI needs this) -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- Allow outbound network connections (needed for Supabase, Anthropic, etc.) -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
